+    // Configure VFS "data:" ([vfs+0x160]) and "asset:" to use LocalDirectoryFileSystem (vtable 0x1a779d8)
+    void* vfs = ((fn_ptr_t)(g_libg_base + 0x14cd2f0 /* arm 0x1463e2c */))();
